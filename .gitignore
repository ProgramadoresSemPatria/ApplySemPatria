# Secrets & credentials
secrets/
.env
.env.*
*.pem
*.key

# Local runtime state (apply progress, tokens, table window)
state/

# Job registry & discovery output (rebuilt on each machine)
/registry/**
!/registry/.gitkeep

# Generated runs, tables, audits, raw collect JSON
/runs/**
!/runs/tables/
/runs/tables/**
!/runs/tables/README.md

# Per-track personal data (copy from examples/tracks/<id>/)
/tracks/**
!/tracks/.gitkeep

# Legacy root-level configs (prefer tracks/<id>/ after onboarding)
/applicant-profile.json
/profile.json
/config.json
/email-apply-config.json
/linkedin-posts-config.json
/google-jobs-config.json
/form-answers.json

# Resumes & attachments
*.pdf
*.docx
*.doc

# Python
.venv/
.venv-test/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Browser automation profiles
patchright-profile/
.playwright/

# OS / editor
.DS_Store
.idea/
.vscode/
