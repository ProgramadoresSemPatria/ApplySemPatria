{
  "name": "linkedin-easy-apply-open",
  "description": "Open a LinkedIn job listing and click Easy Apply to launch the in-modal wizard.",
  "match": { "url_contains": ["linkedin.com/jobs/view/"] },
  "vars_required": ["job_url"],
  "steps": [
    { "action": "goto", "target": "{job_url}", "wait_until": "domcontentloaded", "timeout": 90000 },
    { "action": "sleep", "seconds": 2.5 },
    { "action": "dismiss_premium", "optional": true },
    { "action": "sleep", "seconds": 0.4 },
    { "action": "click", "role": "button", "name_regex": "^Easy Apply$|^Easy Apply to ", "timeout": 20000 },
    { "action": "sleep", "seconds": 2.0 },
    { "action": "assert_visible", "selector": ".jobs-easy-apply-modal, .jobs-easy-apply-content, [data-test-modal-id='easy-apply-modal']" }
  ]
}
