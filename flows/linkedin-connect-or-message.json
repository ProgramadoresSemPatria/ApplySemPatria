{
  "name": "linkedin-connect-or-message",
  "description": "Linear priority flow: (1) tap top-card Connect when visible, (2) unchanged More-menu connect path when Connect is only in the menu, (3) message only when no Connect on the profile. Top-card Connect is tried first via click_connect; More menu steps are preserved verbatim for menu-only profiles.",
  "match": { "url_contains": ["linkedin.com/in/"] },
  "vars_required": ["profile_url", "message"],
  "steps": [
    { "action": "dismiss_premium", "optional": true },
    { "action": "sleep", "seconds": 0.3 },
    { "action": "click_connect", "optional": true },
    { "action": "sleep", "seconds": 1.3 },
    { "action": "click", "role": "button", "name_regex": "Send without|Not now|Continue without Premium|Continue for free", "optional": true, "destructive": true, "commit": true, "commit_kind": "connect" },
    { "action": "sleep", "seconds": 1.0 },

    { "action": "abort_if_connect_on_main", "optional": true },

    { "action": "click", "scope": "main", "role": "button", "name_regex": "^More", "optional": true },
    { "action": "sleep", "seconds": 1.1 },
    { "action": "click", "role": "menuitem", "name_regex": "^\\+?\\s*connect$|^invite.*to connect$", "optional": true },
    { "action": "sleep", "seconds": 1.3 },
    { "action": "click", "role": "button", "name_regex": "Send without|Not now|Continue without Premium|Continue for free", "optional": true, "destructive": true, "commit": true, "commit_kind": "connect" },
    { "action": "sleep", "seconds": 1.0 },

    { "action": "press", "key": "Escape" },
    { "action": "sleep", "seconds": 0.6 },

    { "action": "abort_if_connect_on_main", "optional": true },

    { "action": "click", "selector": "main a:has-text('Message'), main button:has-text('Message')", "optional": true },
    { "action": "sleep", "seconds": 2.5 },
    { "action": "dismiss_premium", "optional": true },
    { "action": "sleep", "seconds": 0.3 },
    { "action": "fill", "selector": "div.msg-form__contenteditable[contenteditable='true']", "value_template": "{message}", "optional": true },
    { "action": "sleep", "seconds": 0.8 },
    { "action": "click", "selector": "button.msg-form__send-button, button.msg-form__send-btn, .msg-form button[type='submit']", "optional": true, "destructive": true, "commit": true, "commit_kind": "message" },
    { "action": "sleep", "seconds": 1.2 }
  ]
}
