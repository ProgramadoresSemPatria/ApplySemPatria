{
  "_doc": "Reusable form-fill knowledge base (the 'instructions' for filling ATS/job forms). Ordered rules, FIRST MATCH WINS. Each rule's `q` is a case-insensitive regex matched against the field's label + name + id (joined, lowercased). Resolution: `profile_key` pulls from applicant-profile.json; `value` is a literal; for <select>/radio, `option_regex` picks the matching option. Add a new rule here whenever we audit a form and hit a question the bank can't answer — that makes the next form free (no LLM). Keep rules generic so they reuse across companies.",
  "rules": [
    { "q": "\\bfirst\\s*name\\b|given\\s*name|nome\\b(?!.*sobre)", "profile_key": "first_name" },
    { "q": "\\blast\\s*name\\b|surname|family\\s*name|sobrenome", "profile_key": "last_name" },
    { "q": "full\\s*name|your\\s*name|\\bname\\b(?!.*(user|company|file))", "profile_key": "full_name" },
    { "q": "e-?mail", "profile_key": "email" },
    { "q": "phone|mobile|telefone|celular|whats", "profile_key": "phone" },
    { "q": "linkedin", "profile_key": "linkedin_url" },
    { "q": "github", "profile_key": "github_url" },
    { "q": "portfolio|personal\\s*(web)?site|website|\\bsite\\b", "profile_key": "portfolio_url" },
    { "q": "current\\s*(company|employer)", "value": "" },
    { "q": "current\\s*(title|role|position)|headline|cargo", "profile_key": "current_title" },
    { "q": "city|cidade", "profile_key": "city" },
    { "q": "country|pa[ií]s", "profile_key": "country", "option_regex": "brazil|brasil" },
    { "q": "location|address|localiza|where.*(based|located)", "profile_key": "location" },
    { "q": "time\\s*zone|timezone|fuso", "profile_key": "timezone" },
    { "q": "years?\\s*(of)?\\s*experience|experi[êe]ncia|how\\s*many\\s*years", "profile_key": "years_experience" },
    { "q": "per\\s*hour|hourly|\\brate\\b|rate\\s*per", "profile_key": "hourly_rate_usd" },
    { "q": "expected rate|rate \\(usd\\)|/\\s*year|annual|yearly|per\\s*year|^\\$$", "profile_key": "annual_salary_usd" },
    { "q": "salary|compensation|pretens[ãa]o|remunera|expected\\s*(pay|salary)|annual|desired\\s*pay", "profile_key": "salary_expectation_usd" },
    { "q": "notice\\s*period|when\\s*can\\s*you\\s*start|start\\s*date|availab|disponib", "profile_key": "notice_period" },
    { "q": "authoriz.*work|work.*authoriz|legally.*(work|authorized)|right\\s*to\\s*work|eligible.*work", "profile_key": "work_authorization", "option_regex": "yes|authorized|s[ií]" },
    { "q": "sponsor|require.*visa|visa.*(require|need)", "profile_key": "requires_sponsorship", "option_regex": "no\\b|n[ãa]o" },
    { "q": "remote|work\\s*from\\s*home|home\\s*office", "value": "Yes", "option_regex": "yes|remote|s[ií]" },
    { "q": "relocat|mudar|realoc", "value": "No", "option_regex": "no\\b|n[ãa]o" },
    { "q": "multi-agent|multi agent|deployed multi-agent", "profile_key": "multi_agent_production_answer" },
    { "q": "langgraph.*production|built ai applications using langgraph", "value": "Yes", "option_regex": "^yes\\b" },
    { "q": "claude code", "value": "Yes", "option_regex": "^yes\\b" },
    { "q": "model context protocol|\\bmcp\\b", "profile_key": "mcp_production_answer" },
    { "q": "reliability.*observability|observability.*permissions|safe execution.*agent|agent workflows running in production", "profile_key": "agent_observability_answer" },
    { "q": "english proficiency|english level", "profile_key": "english_level", "option_regex": "fluent|native|c1" },
    { "q": "availability", "profile_key": "notice_period", "option_regex": "immediate|immediately|now" },
    { "q": "spanish|espa[ñn]ol", "profile_key": "spanish_level" },
    { "q": "portuguese|portugu[êe]s", "profile_key": "portuguese_level", "option_regex": "native|fluent|c2" },
    { "q": "hands-on.*\\bai\\b|experience with ai\\b|\\bwith ai\\?|generative ai|\\bgen ?ai\\b|experience.*\\brag\\b|\\bllm\\b", "profile_key": "ai_experience_summary" },
    { "q": "deploy.*machine learning|deployed.*\\bml\\b|machine learning.*production|\\bml\\b.*production|model.*to production", "profile_key": "ml_production_answer" },
    { "q": "data pipeline|\\betl\\b|\\belt\\b|production infrastructure|data ingestion|large-scale event|processing large-scale|event or data", "profile_key": "data_pipelines_answer" },
    { "q": "distributed systems|scalable.*(distributed|systems)|built scalable", "profile_key": "distributed_systems_answer" },
    { "q": "python", "profile_key": "python_answer" },
    { "q": "international experience|worked abroad|outside your country|with which company", "profile_key": "international_experience" },
    { "q": "pytorch|tensorflow|\\bml frameworks\\b|deep learning framework|modern ml", "value": "No" },
    { "q": "recommendation|ranking system", "value": "No" },
    { "q": "feature store|real-time inference", "value": "No" },
    { "q": "adtech|personalization|optimization system", "value": "Yes" },
    { "q": "early-stage startup|early stage startup|owned product decisions", "value": "Yes", "option_regex": "^yes\\b" },
    { "q": "from scratch.*production|built and shipped|shipped.*production|ship.*from scratch", "value": "Yes" },
    { "q": "low-latency|low latency|strict reliability|reliability requirements", "value": "Yes" },
    { "q": "comfortable working|work independently|independently in|fast-moving|fast moving|dynamic environment", "value": "Yes" },
    { "q": "can contact me|contact me about|about job opportunities|receive.*(updates|opportunities)|consent to", "value": "Yes", "option_regex": "yes|contact|consent|agree" },
    { "q": "how\\s*did\\s*you\\s*hear|referral\\s*source|source|onde.*conheceu", "value": "LinkedIn", "option_regex": "linkedin" },
    { "q": "cover\\s*letter|why.*(interested|want|apply|you)|motivation|tell\\s*us|about\\s*you|carta", "profile_key": "cover_letter_default" },
    { "q": "gender|g[êe]nero", "value": "Decline to self-identify", "option_regex": "decline|prefer not|don.?t wish|n[ãa]o.*inform" },
    { "q": "race|ethnic|hispanic|latino|ra[çc]a|etnia", "value": "Decline to self-identify", "option_regex": "decline|prefer not|don.?t wish|n[ãa]o.*inform" },
    { "q": "veteran|military", "value": "Decline to self-identify", "option_regex": "decline|prefer not|don.?t wish|not a" },
    { "q": "disab|defici[êe]ncia", "value": "Decline to self-identify", "option_regex": "decline|prefer not|don.?t wish|not to" }
  ]
}
