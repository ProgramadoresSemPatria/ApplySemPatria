  "tech_lexicon": [],
  "masters": [
    {
      "id": "ai-engineer",
      "label": "AI Engineer",
      "pdf_path": "/absolute/path/to/your-master.pdf",
      "docx_path": "/absolute/path/to/your-master.docx",
      "path": "/absolute/path/to/your-master.pdf",
      "default": true,
      "keywords": []
    }
  ]
}
